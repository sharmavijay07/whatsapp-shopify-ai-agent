# Copy to .env. Nothing here is a real secret.
# Mock mode runs the whole demo with no keys. Groq is the default model
# once GROQ_API_KEY is set.

# mock keeps Shopify and WhatsApp on the local sandbox.
# live uses the credentials below and will create real pending orders.
APP_MODE=mock

# --- Language model (OpenAI-compatible) ---
# groq is the default. openai, gemini, ollama, and mock are optional.
LLM_PROVIDER=groq
# Leave blank to use the provider preset.
# groq -> openai/gpt-oss-120b
# openai -> gpt-4o-mini
# gemini -> gemini-2.0-flash
# ollama -> llama3.2
LLM_MODEL=
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=600

# Provider keys. Only the active provider's key is read.
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional override used before the provider-specific key.
LLM_API_KEY=

# --- Embeddings ---
# Groq has no embeddings API.
# sentence-transformers = local MiniLM (extra RAM, the `local` install extra).
# bm25 = in-memory keyword index. This is what Render's free plan uses.
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# --- Vector store ---
# auto + empty QDRANT_URL = in-memory BM25 (no Qdrant service).
# qdrant + empty QDRANT_URL = embedded Qdrant on disk (local demo).
# memory = always BM25. Set this on Render.
VECTOR_STORE=qdrant
QDRANT_URL=
QDRANT_PATH=./data/runtime/qdrant
QDRANT_COLLECTION=harbor_kb

DATABASE_PATH=./data/runtime/harbor.db
# KNOWLEDGE_DIR=
# Leave blank to use the policies shipped in src/harbor/knowledge.

# --- Shopify Admin API (live mode only) ---
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-10

# --- WhatsApp Business Cloud API (live mode only) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=harbor-verify
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# --- n8n ---
# Import n8n/workflows/*.json and point these at the production webhook URLs.
N8N_ORDER_WEBHOOK_URL=
N8N_ERROR_WEBHOOK_URL=
N8N_NOTIFY_WEBHOOK_URL=
N8N_SHARED_SECRET=

# Order gates
MAX_ORDER_VALUE=500
CURRENCY=USD
DRAFT_TTL_MINUTES=30
DUPLICATE_WINDOW_MINUTES=10

PUBLIC_BASE_URL=http://127.0.0.1:8091
CORS_ORIGINS=http://127.0.0.1:43123,http://localhost:43123
LOG_LEVEL=INFO

# Used by the Next.js sandbox to reach the API.
# Inside Docker Compose this is http://api:8091.
API_INTERNAL_URL=http://127.0.0.1:8091
